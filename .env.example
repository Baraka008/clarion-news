# Copy this file to .env.local and fill in the values.
# Leave the Firebase values empty to run Clarion in demo mode with sample stories.

# Public URL of the deployed site (used for share links and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web app config (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account (Project settings > Service accounts > Generate new private key)
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n line breaks exactly as they appear in the JSON key file
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gemini (https://aistudio.google.com/apikey). Without it the assistant uses a simple built-in helper.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
