rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /Users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }

    match /Articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.token.role in ['admin', 'editor'];
    }

    match /Categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /Comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.role in ['admin', 'editor'];
    }

    match /Bookmarks/{bookmarkId} {
      allow read, create, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /Analytics/{docId} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow write: if false;
    }

    match /NewsletterSubscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
